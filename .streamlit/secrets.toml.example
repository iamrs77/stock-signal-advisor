# Copy this file to secrets.toml and add your own keys. secrets.toml is ignored by git.
# All keys are optional. Without them the app uses Yahoo Finance (delayed about 15 minutes).

# Finnhub: real-time US prices during regular market hours. Free key: https://finnhub.io/register
FINNHUB_API_KEY = ""

# Alpaca: real-time intraday bars from the free IEX feed. A free paper-trading account works.
ALPACA_API_KEY = ""
ALPACA_SECRET_KEY = ""

# Set to true on a public deployment, so each visitor's trade log stays in their own session.
DEMO_MODE = false
